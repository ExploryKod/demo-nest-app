# Root level .gitignore for monorepo

# Note: quizzam and quizzy-front are now Git submodules
# They are managed via .gitmodules and git submodule commands
# No need to ignore their .git directories as they are proper submodules

# Environment variables
.env
.env.*
!.env.example
quizzam/.env
quizzy-front/.env

# Firebase credentials
**/firebase*key*.json
**/*firebase*key*.json
**/google-services.json
**/GoogleService-Info.plist

# Secrets and credentials
**/secrets/
**/*secret*
**/*credential*
**/*.pem
**/*.key
**/*.p12
**/*.pfx

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Logs
*.log
logs/

# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
dist/
build/
*.tsbuildinfo

# Nx
.nx/
nx.json.bak

